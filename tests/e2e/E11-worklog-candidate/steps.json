{
  "description": "E11 candidate loop from a worklog run (stub level): with the worklog add-on turned on, a curation run writes the day's worklog: the scripted verdict skill reads the facts and hands in a verdict with one memory candidate, the writer files the note into the inbox, the ledger and its two exports, proposes the candidate and moves the watermark, and the ingest of the same run moves the note into the corpus. The owner ticks the candidate, harvest turns it into an inbox capture, and a second run the same day writes no second worklog.",
  "model": {
    "skills": {
      "/m2b:worklog-verdict": {
        "actions": [
          {
            "tool": "Bash",
            "command": "m2b-worklog facts --json"
          },
          {
            "tool": "Read",
            "file_path": "<store>/memory/MEMORY.md"
          },
          {
            "tool": "Bash",
            "command": "m2b-worklog verdict '{\"version\": 1, \"sessions\": [], \"candidates\": [{\"text\": \"Robin moves to Lyon in May\"}]}'"
          }
        ]
      },
      "/m2b:ingest": [
        {
          "actions": [
            {
              "tool": "Bash",
              "command": "m2b ingest list --json"
            },
            {
              "tool": "Bash",
              "command": "m2b ingest note <capture:worklog> 'filed: current only'"
            },
            {
              "tool": "Bash",
              "command": "m2b ingest finish <capture:worklog>"
            }
          ]
        },
        {
          "actions": []
        }
      ]
    }
  },
  "steps": [
    {
      "run": [
        "m2b",
        "launcher",
        "install"
      ]
    },
    {
      "run": [
        "m2b",
        "addons",
        "on",
        "worklog"
      ]
    },
    {
      "run": [
        "m2b",
        "curate",
        "--force"
      ]
    },
    {
      "run": [
        "m2b",
        "tasks",
        "list",
        "--marker",
        "candidate",
        "--json"
      ],
      "save": {
        "task": "\"id\": \"([0-9a-f]{12})\""
      }
    },
    {
      "run": [
        "m2b",
        "tasks",
        "complete",
        "{task}"
      ]
    },
    {
      "run": [
        "m2b",
        "harvest"
      ],
      "stdout": "\\Acaptured inbox/\\d{8}T\\d{6}Z-candidate-[0-9a-f]{4}\\.md\\n\\Z",
      "env": {
        "M2B_CURATION_RUN": "1"
      }
    },
    {
      "run": [
        "m2b",
        "curate",
        "--force"
      ]
    }
  ]
}
