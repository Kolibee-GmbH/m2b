{
  "description": "E11 at the model level: a ticked candidate is harvested and the real ingest files it and the capture an earlier harvest left as facts, each with its evidence link once; the open candidate stays.",
  "steps": [
    {
      "run": [
        "m2b",
        "tasks",
        "complete",
        "aaaa00000001"
      ]
    },
    {
      "run": [
        "m2b",
        "curate",
        "--force"
      ]
    }
  ],
  "invariants": [
    {
      "run_state": "succeeded"
    },
    {
      "no_denials": true
    },
    {
      "count": 0,
      "glob": "inbox/*"
    },
    {
      "count": 2,
      "glob": "corpus/*/*/*-candidate-*.md"
    },
    {
      "matches": "(?i)dana[^\\n]*tea",
      "path": "memory/MEMORY.md"
    },
    {
      "matches": "(?i)robin[^\\n]*lyon",
      "path": "memory/MEMORY.md"
    },
    {
      "once": "\\[\\[20261107T020000Z-candidate-c3c3\\.md\\]\\]",
      "glob": "memory/*.md"
    },
    {
      "count": 1,
      "glob": "tasks/*.md",
      "content": "m2b:candidate"
    }
  ]
}
