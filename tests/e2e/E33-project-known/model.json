{
  "description": "E33 at the model level: a real ingest step files a project capture, made in a clone with `m2b capture --project`, as a topic of its own: a heading with two to five words, the repository's name `portal` among them, and the `Repository:` line first, copied with the address as captured. A session that starts in the clone gets the topic with the folder it lies in, and asking again captures nothing. Run it after a change to the ingest skill: the topic is the model's filing, not m2b's code.",
  "steps": [
    {
      "run": [
        "git",
        "init",
        "-q"
      ],
      "cwd": "portal",
      "env": {
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null"
      }
    },
    {
      "run": [
        "git",
        "remote",
        "add",
        "origin",
        "git@github.com:acme/portal.git"
      ],
      "cwd": "portal",
      "env": {
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null"
      }
    },
    {
      "run": [
        "m2b",
        "capture",
        "--project",
        "--source",
        "claude",
        "-"
      ],
      "cwd": "portal",
      "env": {
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null"
      },
      "stdin": "the customer portal we build for Acme"
    },
    {
      "run": [
        "m2b",
        "curate",
        "--force"
      ],
      "env": {
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null"
      }
    },
    {
      "run": [
        "m2b",
        "hook",
        "distillate"
      ],
      "cwd": "portal",
      "env": {
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null"
      },
      "stdin": "{\"session_id\": \"0a1b2c3d-1111-4222-8333-444455556666\"}",
      "stdout": "\\n- Repository: github\\.com/acme/portal \\([a-z0-9-]+\\.md\\)\\n  on this machine: [^\\n]*/portal\\n"
    },
    {
      "run": [
        "m2b",
        "capture",
        "--project",
        "--source",
        "claude",
        "-"
      ],
      "cwd": "portal",
      "env": {
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null"
      },
      "stdin": "the portal",
      "stdout": "already known as the topic"
    }
  ],
  "invariants": [
    {
      "run_state": "succeeded"
    },
    {
      "no_denials": true
    },
    {
      "count": 0,
      "glob": "inbox/*"
    },
    {
      "matches": "(?s)## Facts(?:(?!\\n## ).)*\\n### [^\\n(]+\\((?=[^)\\n]*(?i:\\bportal\\b))[^,)\\n]+(?:, [^,)\\n]+){1,4}\\)\\n- Repository: github\\.com/acme/portal \\([a-z0-9-]+\\.md\\)\\n",
      "path": "memory/MEMORY.md"
    },
    {
      "once": "(?m)^- Repository: github\\.com/acme/portal ",
      "glob": "memory/MEMORY.md"
    }
  ]
}
