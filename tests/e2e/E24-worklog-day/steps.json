{
  "description": "A day's worklog inside a curation run (stub level): with the worklog add-on turned on, a curation run writes the day's worklog: the scripted verdict skill reads the facts, writes its verdict to its file and hands it in, the writer files the note into the inbox, the ledger and its two exports and moves the watermark, and the ingest of the same run moves the note into the corpus. The worklog proposes nothing for memory: no candidate is in the task list afterwards. A second run the same day writes no second worklog.",
  "model": {
    "skills": {
      "/m2b:worklog-verdict": {
        "actions": [
          {
            "tool": "Bash",
            "command": "m2b-worklog facts --json"
          },
          {
            "tool": "Write",
            "file_path": "<m2b-home>/.local/state/m2b/worklog-run/verdict-draft.json",
            "content": "{\"version\": 1, \"sessions\": []}"
          },
          {
            "tool": "Bash",
            "command": "m2b-worklog verdict"
          }
        ]
      },
      "/m2b:ingest": [
        {
          "actions": [
            {
              "tool": "Bash",
              "command": "m2b ingest list --json"
            },
            {
              "tool": "Bash",
              "command": "m2b ingest note <capture:worklog> 'filed: current only'"
            },
            {
              "tool": "Bash",
              "command": "m2b ingest finish <capture:worklog>"
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "run": [
        "m2b",
        "launcher",
        "install"
      ]
    },
    {
      "run": [
        "m2b",
        "addons",
        "on",
        "worklog"
      ]
    },
    {
      "run": [
        "m2b",
        "curate",
        "--force"
      ]
    },
    {
      "run": [
        "m2b",
        "tasks",
        "list",
        "--marker",
        "candidate",
        "--json"
      ],
      "stdout": "\\A\\[\\]\\n\\Z"
    },
    {
      "run": [
        "m2b",
        "curate",
        "--force"
      ]
    }
  ]
}
