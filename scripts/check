#!/bin/sh
# The repository's proof.
#
#   scripts/check --quick <suite>    one suite with python3 on PATH: m2b (the core's Python), band
#                                    (the core's mod, in Claude Code's test kit) or worklog
#   scripts/check                    everything; exits 1 when any stage fails
#
# The full run covers the unit tests of the core, of each add-on and of the repository tools (with
# python3, and on macOS also with /usr/bin/python3 when that is Python 3.9), the core once more in a
# copy of the plugin without its add-ons, ruff, mypy,
# the shell linter, the workflow linter, the plugin manifest, the tests of the band (the core's mod),
# the B/X coverage report and the end-to-end scenarios at the stub level.
#
# The add-ons' tests sit in plugins/m2b/tests/addons/<add-on>/ under a folder without __init__.py, so
# the core's discovery does not descend into them and each runs as its own suite. An add-on's suite
# may use the fixtures of the core's tests, so their folder is on its path; the core's suite uses
# nothing of an add-on, which the core-alone stage proves.
set -eu

readonly RUFF_VERSION=0.16.3
# mypy 2 no longer type-checks for Python 3.9.
readonly MYPY_VERSION=1.19.1
# The package on PyPI that installs actionlint; its first three numbers are actionlint's version.
readonly ACTIONLINT_PACKAGE_VERSION=1.7.12.25
readonly LEGACY_PYTHON=/usr/bin/python3

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

failed_stages=""

# POSIX sh has no local variables, so the functions below read their arguments as $1..$n
# and give every variable they set a name no other function uses.

usage() {
    echo "usage: scripts/check [--quick m2b|worklog|band]" >&2
    exit 2
}

# Arguments: python, tests folder, label, import roots.
run_unit_tests() {
    unit_tests_python=$1
    unit_tests_dir=$2
    unit_tests_label=$3
    shift 3
    # Turns the remaining arguments (the import roots) into --import-root pairs.
    for unit_tests_root in "$@"; do
        set -- "$@" --import-root "$unit_tests_root"
        shift
    done
    PYTHONPATH="$repo_root/scripts" "$unit_tests_python" -m repo_tools.unit_tests \
        --tests "$unit_tests_dir" --label "$unit_tests_label" "$@"
}

readonly PLUGIN=plugins/m2b

# Arguments: python, suite (m2b for the core, else an add-on's name).
run_suite() {
    if [ "$2" = m2b ]; then
        run_unit_tests "$1" "$PLUGIN/tests" m2b "$PLUGIN/src"
    else
        run_unit_tests "$1" "$PLUGIN/tests/addons/$2" "$2" "$PLUGIN/src" "$PLUGIN/tests"
    fi
}

suites() {
    echo m2b
    for suite_folder in "$PLUGIN"/tests/addons/*/; do
        basename "$suite_folder"
    done
}

# Arguments: stage name, command. Runs one stage and records its name when it fails.
stage() {
    stage_name=$1
    shift
    echo "== $stage_name"
    if ! "$@"; then
        failed_stages="$failed_stages $stage_name"
    fi
}

# Arguments: tool, pinned version, the tool's arguments.
dev_tool() {
    dev_tool_name=$1
    dev_tool_version=$2
    shift 2
    if command -v uvx >/dev/null 2>&1; then
        uvx --quiet --from "$dev_tool_name==$dev_tool_version" "$dev_tool_name" "$@"
    elif command -v "$dev_tool_name" >/dev/null 2>&1; then
        "$dev_tool_name" "$@"
    else
        echo "$dev_tool_name is not installed and uvx is missing; install uv to run it" >&2
        return 1
    fi
}

python_version_of() {
    "$1" -c 'import sys; print(sys.version)'
}

pythons_to_test() {
    echo python3
    if [ "$(uname -s)" = Darwin ] && [ -x "$LEGACY_PYTHON" ] \
        && "$LEGACY_PYTHON" -c 'import sys; sys.exit(sys.version_info[:2] != (3, 9))' \
        && [ "$(python_version_of "$LEGACY_PYTHON")" != "$(python_version_of python3)" ]; then
        echo "$LEGACY_PYTHON"
    fi
}

all_unit_tests() {
    unit_status=0
    for unit_python in $(pythons_to_test); do
        for unit_suite in $(suites); do
            run_suite "$unit_python" "$unit_suite" || unit_status=1
        done
        run_unit_tests "$unit_python" scripts/repo_tools/tests repo-tools scripts "$PLUGIN/src" \
            || unit_status=1
    done
    return "$unit_status"
}

# The core's unit tests, and the end-to-end scenarios that turn no add-on on, in a temporary copy of
# the plugin without any part of an add-on.
core_alone() {
    PYTHONPATH="$repo_root/scripts" python3 -m repo_tools.core_alone
}

ruff_checks() {
    dev_tool ruff "$RUFF_VERSION" check . && dev_tool ruff "$RUFF_VERSION" format --check .
}

mypy_checks() {
    mypy_status=0
    MYPYPATH="$PLUGIN/src" dev_tool mypy "$MYPY_VERSION" "$PLUGIN/src" || mypy_status=1
    # The worklog's recorder runs from its own copy outside any package, so it is checked on its own.
    dev_tool mypy "$MYPY_VERSION" "$PLUGIN/recorder/record.py" || mypy_status=1
    MYPYPATH=scripts:plugins/m2b/src dev_tool mypy "$MYPY_VERSION" -p repo_tools || mypy_status=1
    return "$mypy_status"
}

shell_checks() {
    if ! command -v shellcheck >/dev/null 2>&1; then
        echo "shellcheck not installed; skipped"
        return 0
    fi
    shellcheck scripts/check scripts/e2e scripts/e2e-shortcut-setup scripts/evals-page scripts/glean-eval \
        scripts/ingest-eval scripts/no-model scripts/readme-images \
        "$PLUGIN"/bin/m2b "$PLUGIN"/bin/m2b-worklog
}

# GitHub starts no run from a workflow file it cannot read and tells no one, so a mistake in a
# scheduled workflow shows as nothing happening.
workflow_checks() {
    if command -v uvx >/dev/null 2>&1; then
        uvx --quiet --from "actionlint-py==$ACTIONLINT_PACKAGE_VERSION" actionlint .github/workflows/*.yml
    elif command -v actionlint >/dev/null 2>&1; then
        actionlint .github/workflows/*.yml
    else
        echo "actionlint not installed and uvx is missing; skipped"
    fi
}

manifest_checks() {
    if ! command -v claude >/dev/null 2>&1; then
        echo "claude not installed; skipped"
        return 0
    fi
    claude plugin validate --strict . && claude plugin validate --strict "$PLUGIN"
}

# The band is a mod in TypeScript; its tests run in Claude Code's own test kit.
band_tests() {
    if ! command -v claude >/dev/null 2>&1; then
        echo "claude not installed; skipped"
        return 0
    fi
    claude plugin test "$PLUGIN"
}

coverage_report() {
    PYTHONPATH="$repo_root/scripts" python3 -m repo_tools.coverage_check
}

if [ "$#" -gt 0 ]; then
    if [ "$1" != --quick ] || [ "$#" -ne 2 ]; then
        usage
    fi
    if [ "$2" = band ]; then
        quick_status=0
        claude plugin test "$PLUGIN" || quick_status=1
        exit "$quick_status"
    fi
    if [ "$2" != m2b ] && [ ! -d "$PLUGIN/tests/addons/$2" ]; then
        echo "no such suite: $2" >&2
        usage
    fi
    if run_suite python3 "$2"; then
        exit 0
    fi
    exit 1
fi

# Locally a missing claude skips the manifest and band checks; in CI that would pass a run in
# which they never ran, so there it ends the run before anything starts.
if [ "${CI:-}" = true ] && ! command -v claude >/dev/null 2>&1; then
    echo "check: claude is not installed; CI needs it for the manifest and band checks" >&2
    exit 1
fi

stage unit-tests all_unit_tests
stage core-alone core_alone
stage ruff ruff_checks
stage mypy mypy_checks
stage shellcheck shell_checks
stage workflows workflow_checks
stage manifests manifest_checks
stage band band_tests
stage coverage coverage_report
stage e2e scripts/e2e --level stub

if [ -n "$failed_stages" ]; then
    echo "check: FAILED:$failed_stages"
    exit 1
fi
echo "check: passed"
