#!/bin/sh
# Records the moving pictures in docs/images/ from real Claude Code sessions against a demo store
# with invented data: the README's demo.gif, one sentence from a prompt into a later session, which
# costs two model turns and one curation run, and two of the pane driven with the keyboard, which
# ask no model. --only <name> records one. Needs claude (logged in), agg and git. Watch each picture
# through before committing it.
set -eu

repo_root=$(cd "$(dirname "$0")/.." && pwd)
PYTHONPATH="$repo_root/scripts${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m repo_tools.readme_demo "$@"
