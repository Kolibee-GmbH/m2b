#!/bin/sh
# The core's prompt hook: runs before every prompt, so it starts the m2b package with only the
# modules the hook needs instead of the whole command line.
set -eu
plugin_root=$(cd "$(dirname "$0")/.." && pwd)
# -I keeps the working directory (the user's project in Claude Code) and PYTHONPATH off sys.path,
# so no file there can stand in for this package or the standard library; Python 3.9 has no -P.
exec "${M2B_PYTHON:-python3}" -I -c \
    'import sys; sys.path.insert(0, sys.argv.pop(1)); from m2b.prompt_hook import main; sys.exit(main())' \
    "$plugin_root/src" "$@"
